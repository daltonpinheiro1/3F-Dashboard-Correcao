VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# OPENAI_API_KEY: só em .dev.vars / Cloudflare Pages secret — nunca no front nem no git
# DASHBOARD_INSIGHT_SECRET: só no Pages (Functions) / .dev.vars — NUNCA VITE_* no browser
# Auth do front → Functions: X-Dashboard-Email + X-Dashboard-Session (nonce do login)

# E-mail ao solicitante (Cloudflare Email Service — REST API nas Functions)
# ADVERTENCIAS_EMAIL_ENABLED=true
# CF_ACCOUNT_ID=your-cloudflare-account-id
# CF_API_TOKEN=token-with-email-sending
# ADVERTENCIAS_EMAIL_FROM=RH 3F <rh@seudominio.com.br>
# ADVERTENCIAS_EMAIL_REPLY_TO=dp@seudominio.com.br

# Atestados — arquivamento SMB (\\files\03 Operação\Atestados)
# ATESTADOS_STORAGE_BASE=Atestados
# Push em tempo real (bridge na rede 3F — ver scripts/atestados-smb-bridge.mjs)
# ATESTADOS_SMB_BRIDGE_URL=https://seu-tunnel-ou-ip:8788
# ( /push é anexado automaticamente se omitido )
# ATESTADOS_SMB_BRIDGE_SECRET=token_longo
# Se bridge offline: arquivo completo em _pending_smb até npm run smb:sync
# Serviço 24h: npm run smb:install-macos  ou  sudo npm run smb:install-linux
# Credenciais de montagem SMB: copie .env.smb.example → .env.smb (nunca commitar)

# Portabilidade / Disparos (Cloudflare Pages secrets)
# PORTABILIDADE_SUPABASE_URL=https://xxx.supabase.co
# PORTABILIDADE_SUPABASE_SERVICE_KEY=...
# Meta mensal portados (% do universo cohort) — padrão 40%
# PORTABILIDADE_META_PORTADOS_PCT=40
# PORTABILIDADE_META_JSON={"2026-08":{"portados_pct":40},"default":{"portados_pct":40}}
# Alertas P0 → Slack (dedup 4h via KV RATE_LIMIT)
# PORTABILIDADE_P0_ALERT_ENABLED=true
# PORTABILIDADE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DASHBOARD_PUBLIC_URL=https://3f-dashboard-correcao.pages.dev

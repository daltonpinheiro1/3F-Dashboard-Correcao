# Credenciais SMB — copie para .env.smb (não versionado)
# Share: smb://files/03 Operação/Atestados

SMB_HOST=files
SMB_SHARE="03 Operação"
# LAN/macOS ou VM: user curto + SMB_DOMAIN (cred file / nsmb)
# Alternativa UPN: seu.usuario@3fcontactcenter.local (aí deixe SMB_DOMAIN vazio)
SMB_USER=dalton.pinheiro
SMB_DOMAIN=3FCONTACTCENTER
SMB_PASSWORD="sua_senha"
SMB_MOUNT="/Volumes/03 Operação"

# Pasta física dos arquivos (subpasta Atestados do share)
# macOS: "/Volumes/03 Operação/Atestados"
# Linux/VM (CIFS): /mnt/3f-files/Atestados — SMB_HOST=192.168.10.33
ATESTADOS_SMB_ROOT="/Volumes/03 Operação/Atestados"

# Bridge local (push em tempo real do Cloudflare)
# Default bind 127.0.0.1 — ATESTADOS_SMB_BRIDGE_BIND=0.0.0.0 só com tunnel
ATESTADOS_SMB_BRIDGE_PORT=8788
ATESTADOS_SMB_BRIDGE_SECRET=gere_um_token_longo_aleatorio
# ATESTADOS_SMB_BRIDGE_BIND=127.0.0.1

# Obrigatório para npm run smb:sync — projeto DASHBOARD (não Qigger)
# Mesmos valores de SUPABASE_URL / SUPABASE_SERVICE_KEY do Cloudflare Pages
# ATESTADOS_SUPABASE_URL=https://ayhrwxsxqddpeukydblz.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...service_role_do_dashboard...

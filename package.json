{
  "name": "3f-dashboard-correcao",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:pages": "npm run build && wrangler pages dev dist",
    "typecheck": "npm run typecheck:app && npm run typecheck:functions && npm run typecheck:node",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:functions": "tsc --noEmit -p tsconfig.functions.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint \"functions/_lib/**/*.ts\" vite.config.ts eslint.config.js",
    "gate": "npm run test:guards",
    "test:unit": "vitest run",
    "test:guards": "bash scripts/check-regressao.sh",
    "test:ops": "bash scripts/verify-ops.sh",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e:functions": "playwright test --config playwright.functions.config.ts",
    "test:e2e:advertencias": "playwright test e2e/advertencias-fluxo.spec.ts",
    "test:e2e:atestados": "playwright test e2e/atestados-fluxo.spec.ts",
    "smb:mount": "bash scripts/mount-atestados-smb.sh",
    "smb:bridge": "node scripts/atestados-smb-bridge.mjs",
    "smb:sync": "node scripts/sync-atestados-smb.mjs",
    "smb:watch": "node scripts/smb-network-watcher.mjs",
    "smb:install-macos": "bash scripts/install-atestados-service-macos.sh",
    "smb:install-linux": "bash scripts/install-atestados-service-linux.sh"
  },
  "dependencies": {
    "browserslist": "^4.28.9",
    "date-fns": "^4.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.0",
    "tesseract.js": "^5.1.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.130.0"
  }
}

[Unit]
Description=3F Atestados SMB Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_ROOT__
# Sem EnvironmentFile: paths com espaço e senhas com % quebram no systemd.
# O bridge carrega .env.smb via parser Node (override).
ExecStart=/usr/bin/env node __PROJECT_ROOT__/scripts/atestados-smb-bridge.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
